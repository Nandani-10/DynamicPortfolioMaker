# ── Firebase client SDK (safe to expose to the browser) ─────────────────────
# From Firebase Console → Project settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Cloudinary (unsigned browser uploads) ───────────────────────────────────
# Cloud name: Cloudinary Console → Dashboard.
# Upload preset: Cloudinary Console → Settings → Upload → Upload presets →
#   "Add upload preset", set Signing Mode to *Unsigned*, and copy its name.
#   The app is a static site with no server, so uploads are unsigned — lock
#   the preset down there (allowed formats, max file size).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── Gemini (optional shared AI key) ─────────────────────────────────────────
# Leave EMPTY unless you have read this.
#
# Set it and the AI assistant and "Rewrite with AI" work for everyone on the
# site with no key of their own. But NEXT_PUBLIC_* values are inlined into the
# JavaScript bundle, and this app is a static export with no server to hide a
# secret behind — anyone who opens devtools on the deployed site can read this
# key and spend its quota.
#
# If you set it: Google Cloud Console → Credentials → the key → Application
# restrictions → Websites, listing only your own domains. That blocks casual
# reuse from other origins. It is not airtight (a referrer header can be
# forged), so never point this at a key on a billed account.
#
# Leave it empty and each owner supplies their own key in the dashboard.
NEXT_PUBLIC_GEMINI_API_KEY=

# ── The private couple space at /us ─────────────────────────────────────────
# There is no guest list here on purpose. Who may open /us is decided in
# firestore.rules, which matches the SHA-256 of the signed-in address, so
# neither address ends up in this repository or in the browser bundle. The app
# simply asks the database whether it is welcome.

# Optional: which document the space lives under (spaces/<id>). Any string.
NEXT_PUBLIC_US_SPACE_ID=us

# Optional shared PIN. Set it and /us asks for it once every 12 hours on each
# device — a second lock for a phone that is already unlocked. It is visible in
# the bundle, so treat it as a curtain, not a vault; the email allowlist above
# is the real lock.
NEXT_PUBLIC_US_PIN=

# Set to 1 only for local development against `firebase emulators:start`
# (auth on :9099, firestore on :8080). Never set it in a deployed build.
NEXT_PUBLIC_FIREBASE_EMULATORS=
