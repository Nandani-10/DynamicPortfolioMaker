rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid} — private profile mapping uid -> claimed username.
    // Only the owning user may read or write their own profile doc.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // spaces/{spaceId} — the private couple space at /us.
    //
    // Matched on the SHA-256 of the signed-in address rather than the address
    // itself: this repository is public, and a rules file is the one place a
    // private space would otherwise have to publish both owners' email
    // addresses in plain text. The app never sees this list at all — it finds
    // out whether it is welcome by trying to read the space and handling the
    // refusal, so nothing here is inlined into the deployed JavaScript either.
    //
    // To change who gets in, replace a digest below with:
    //   printf '%s' 'their@address.com' | openssl dgst -sha256 -hex
    // (lower-case the address first — the rule lower-cases what it compares).
    //
    // Note it is the *hex* digest that is compared: rules also offer
    // toBase64(), but its output does not match a base64-encoded SHA-256, and
    // a mismatch here fails closed and silently locks you both out.
    function coupleEmailHashes() {
      return [
        '2fd5027b9f7a445bed3081cf2fa6e0063b415bf62c4192fa00763e6d4551ff46',
        'bf8ceafb121520aca1ec4c2498b5ea1baf932b3e9b18431f331e8abbf1c280de',
      ];
    }

    function isPartner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && hashing.sha256(request.auth.token.email.lower()).toHexString().lower()
             in coupleEmailHashes();
    }

    match /spaces/{spaceId}/{document=**} {
      allow read, write: if isPartner();
    }

    // portfolios/{username} — publicly readable (this is the whole point:
    // anyone with the link can view a published portfolio). Writes are
    // restricted to the authenticated owner (ownerUid on the document).
    match /portfolios/{username} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerUid;

      allow update: if request.auth != null
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.username == resource.data.username;

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;
    }
  }
}
