rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid} — private profile mapping uid -> claimed username.
    // Only the owning user may read or write their own profile doc.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // spaces/{spaceId} — the private couple space at /us.
    //
    // ⚠️ EDIT THIS LIST. Put the same two Google addresses here that you set in
    // NEXT_PUBLIC_US_EMAILS. The app checks them too, but only this rule is
    // enforceable: without it, anyone signed in could read the whole space.
    // Leaving the placeholders in place locks everybody out, which is the safe
    // way to fail.
    function coupleEmails() {
      return ['partner-one@example.com', 'partner-two@example.com'];
    }

    function isPartner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in coupleEmails();
    }

    match /spaces/{spaceId}/{document=**} {
      allow read, write: if isPartner();
    }

    // portfolios/{username} — publicly readable (this is the whole point:
    // anyone with the link can view a published portfolio). Writes are
    // restricted to the authenticated owner (ownerUid on the document).
    match /portfolios/{username} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerUid;

      allow update: if request.auth != null
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.username == resource.data.username;

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;
    }
  }
}
